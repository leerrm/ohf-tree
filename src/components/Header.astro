---
interface Props {
  name: string;
  tagline?: string;
  avatar?: string;
  logo?: { light: string; dark?: string };
}

const { name, tagline, avatar, logo } = Astro.props;
const toPath = (path: string) => new URL(path, Astro.site ?? 'http://localhost').pathname;
const avatarUrl = avatar ? toPath(avatar) : undefined;
---

<header class="header">
  {
    logo ? (
      <h1 class="header__name header__name--logo">
        <picture>
          {logo.dark && <source srcset={toPath(logo.dark)} media="(prefers-color-scheme: dark)" />}
          <img class="header__logo" src={toPath(logo.light)} alt={name} decoding="async" />
        </picture>
      </h1>
    ) : (
      <>
        {avatarUrl && (
          <img
            class="header__avatar"
            src={avatarUrl}
            width="88"
            height="88"
            alt=""
            decoding="async"
          />
        )}
        <h1 class="header__name">{name}</h1>
      </>
    )
  }
  {tagline && <p class="header__tagline">{tagline}</p>}
</header>
